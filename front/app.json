{
  "expo": {
    "name": "makemilliondollor",
    "slug": "makemilliondollor",
    "version": "1.0.0",
    "plugins": [
      "expo-build-properties",
      [
        "react-native-share",
        {
          "ios": [
            "fb",
            "instagram",
            "twitter",
            "tiktoksharesdk"
          ],
          "android": [
            "com.facebook.katana",
            "com.instagram.android",
            "com.twitter.android",
            "com.zhiliaoapp.musically"
          ],
          "enableBase64ShareAndroid": true
        }
      ]
    ]
  }
}
